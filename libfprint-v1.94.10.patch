+                error('OpenCV (core, imgproc, features2d) is required for @0@'.format(driver))
+            endif
+            opencv_dep = declare_dependency(dependencies: opencv_libs,
+                compile_args: '-I' + opencv_inc)
+        endif
+
+        optional_deps += opencv_dep
